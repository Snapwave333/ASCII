# Production Deployment Configuration
# NeonGlyph Application Stack - Production Ready

# Database Configuration
DATABASE_URL=postgresql://neonglyph_prod:secure_password@prod-db.example.com:5432/neonglyph_prod
DATABASE_POOL_SIZE=20
DATABASE_TIMEOUT=30000

# API Configuration
API_BASE_URL=https://api.neonglyph.app
API_VERSION=v1
API_RATE_LIMIT=1000
API_TIMEOUT=30000

# Security Configuration
JWT_SECRET=your-secure-jwt-secret-key-here
ENCRYPTION_KEY=your-secure-encryption-key-here
CORS_ORIGINS=https://neonglyph.app,https://www.neonglyph.app
SSL_CERT_PATH=/etc/ssl/certs/neonglyph.crt
SSL_KEY_PATH=/etc/ssl/private/neonglyph.key

# Monitoring Configuration
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
LOG_LEVEL=info
METRICS_ENABLED=true
HEALTH_CHECK_INTERVAL=30

# Performance Configuration
CACHE_TTL=3600
REDIS_URL=redis://prod-redis.example.com:6379/0
CDN_URL=https://cdn.neonglyph.app

# Application Configuration
NODE_ENV=production
PORT=443
HOST=0.0.0.0
CLUSTER_MODE=true
WORKER_PROCESSES=4

# Feature Flags
ENABLE_REAL_TIME_FEATURES=true
ENABLE_ADVANCED_ANALYTICS=true
ENABLE_USER_NOTIFICATIONS=true
ENABLE_BACKGROUND_JOBS=true

# Backup Configuration
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30
BACKUP_ENCRYPTION=true